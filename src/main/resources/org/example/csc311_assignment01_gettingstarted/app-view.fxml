<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.csc311_assignment01_gettingstarted.AppController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label fx:id="welcomeText"/>

    <TextField fx:id="num1Field" promptText="Enter first number"/>
    <TextField fx:id="num2Field" promptText="Enter second number"/>

    <Button text="Calculate Sum" onAction="#onCalculateButtonClick"/>

</VBox>